{
  "name": "shading-app",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "shading.app/*",
      "zone_name": "shading.app"
    }
  ],
  "exports": {
    // Retires the namespace of the removed collaboration Durable Object.
    "TeamRoom": {
      "type": "durable-object",
      "state": "deleted"
    }
  },
  "assets": {
    "directory": "../build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/js/*",
      "/p",
      "/p/*"
    ]
  }
}
