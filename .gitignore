# Integrated scratch-blocks (upstream ignore rules)
# OSX
scratch-blocks/.DS_Store

# NPM
scratch-blocks/node_modules
scratch-blocks/npm-*

# Localization / I18N
scratch-blocks/**/common.pyc
scratch-blocks/**/.settings
scratch-blocks/**/.project
scratch-blocks/**/*.pyc
scratch-blocks/**/*.komodoproject
scratch-blocks/nbproject/private/

# Unused by scratch-blocks
