scratch-blocks/**/javascript_compressed.js
scratch-blocks/**/lua_compressed.js
scratch-blocks/**/php_compressed.js
scratch-blocks/**/python_compressed.js

# Editor
scratch-blocks/**/.vscode

# Build
scratch-blocks/accessible/*
