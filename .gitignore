!scratch-blocks/dist/vertical.js
scratch-blocks/msg/js/*
!scratch-blocks/msg/js/en.js
scratch-blocks/msg/json/*
!scratch-blocks/msg/json/en.json
scratch-blocks/blockly_compressed_horizontal.js
